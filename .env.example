# Copy to .env and fill in from your Supabase project settings (API section).
# Leave BOTH blank to run the app in local mode: everything is stored in this
# browser's localStorage, no account or network needed. Handy for trying things out.
#
# The anon key is designed to be public and ships in the client bundle. It is only
# safe because Row Level Security is enabled on every table — see supabase/schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The single account the shared password logs into. Create this user in the Supabase
# dashboard (Authentication -> Users -> Add user, with "auto confirm" checked).
VITE_FULBITO_EMAIL=fulbito@fulbito.local
